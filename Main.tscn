[node name="Milestone_Terrain" parent="Milestones" instance=ExtResource("6_marker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -8, 44.5, -4)
milestone_id = "m3_terrain"
title = "Milestone 2: Terrain Mesh & Surface Normals"
syllabus_unit = "Unit I & Unit III: Filled Area Primitives, Surface Normals & Shading"
question = "During procedural terrain generation in generate_terrain(), why are surface normals generated and stored per vertex?"
options = Array[String](["A) To compute diffuse and specular illumination in the lighting model across mesh surfaces.", "B) To calculate the audio playback volume of footsteps.", "C) Normals are strictly required by the GPU for vertex position translation.", "D) To compress the index buffer size in memory."])
explanation = "Surface normals define the perpendicular orientation used by shaders and the GPU to calculate light reflection, shading, and slope angles."

[node name="Milestone_MultiMesh" parent="Milestones" instance=ExtResource("6_marker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 44.5, -14)
milestone_id = "m5_multimesh"
title = "Milestone 3: MultiMesh Hardware Instancing"
syllabus_unit = "Unit I & Unit III: Batching (Display Lists) & 3D Affine Transformations"
question = "Why does MultiMesh pack a 3x4 transform matrix buffer per instance rather than spawning distinct SceneTree nodes for each tree and grass blade?"
options = Array[String](["A) It enables GPU hardware instancing, issuing a single draw call with per-instance transform matrices passed to the vertex shader.", "B) Godot cannot handle more than 10 scene nodes in a tree.", "C) It removes the need for vertex shaders entirely.", "D) MultiMesh disables all depth testing to double frame rates."])
explanation = "Hardware instancing sends instance transformation matrices in a buffer to the GPU, drawing thousands of duplicates in one single draw call with minimal CPU overhead."

[node name="Milestone_Camera" parent="Milestones" instance=ExtResource("6_marker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, 44.5, 15)
milestone_id = "m2_camera"
title = "Milestone 4: Camera Hierarchy & Pitch Clamping"
syllabus_unit = "Unit II & Unit IV: Event-Driven Input & 3-D Viewing Coordinate Systems"
question = "In Player.gd, why is the camera attached under a dedicated Node3D pivot and clamped between -90° and +45°?"
options = Array[String](["A) Clamping the elevation pitch prevents gimbal lock, inversion, and preserves the viewing coordinate reference frame.", "B) Godot cameras crash if pitch exceeds 90 degrees.", "C) To restrict network bandwidth in multiplayer VR sessions.", "D) To force orthographic parallel projection instead of perspective projection."])
explanation = "Separating yaw on the player body and clamping pitch on the pivot prevents Euler gimbal lock and avoids disorienting viewport inversion in 3D/VR viewing."

[node name="Milestone_LOD" parent="Milestones" instance=ExtResource("6_marker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -25, 44.5, 20)
milestone_id = "m4_aabb_lod"
title = "Milestone 5: AABB Distance & Visible Surface LOD"
syllabus_unit = "Unit IV & Unit V: 3-D Bounding Volumes, Culling & VR Level of Detail"
question = "Why does ChunkManager check Euclidean distance and AABB overlap before loading or generating chunk geometry?"
options = Array[String](["A) It implements Level-of-Detail (LOD) and view volume culling, avoiding unnecessary GPU rasterization of off-screen/far terrain.", "B) Godot requires all chunks to be square to compile shaders.", "C) Distance checks are only used to trigger audio footsteps.", "D) To convert 3D coordinates into 2D screen coordinates before the vertex stage."])
explanation = "Bounding-volume checks and distance thresholds allow visible surface detection and spatial LOD culling, preventing GPU overdraw outside the active view volume."
